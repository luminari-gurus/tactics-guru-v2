# These are source receipts whose recorded SHA-256 includes original line endings.
collector-v*/*.txt -text whitespace=cr-at-eol
split-probe.ts.txt -text whitespace=cr-at-eol
*.mjs.txt -text whitespace=cr-at-eol
*.ps1.txt -text whitespace=cr-at-eol
startup-*.txt -text whitespace=cr-at-eol,-blank-at-eof
# Preserve capture/manifest bytes so their SHA-256 receipts survive Windows checkout.
startup-*.json -text
# Exact generated HTML contains a doubled CR; preserve this rejected artifact's hash.
startup-preload-v1-index.html.txt -whitespace
probe-preload-reuse-v3.mjs.txt whitespace=cr-at-eol,-blank-at-eof
# Verbatim Playwright error context includes padding in its embedded code frame.
startup-webkit-proof-timeout.txt -whitespace

# Cache-phase source-bound receipts preserve exact captured bytes.
cache-*.json -text
cache-*.txt -text whitespace=cr-at-eol,-blank-at-eof
playwright-cache.config.ts.txt -text whitespace=cr-at-eol,-blank-at-eof
