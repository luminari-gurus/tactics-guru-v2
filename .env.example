# Copy to `.env` and fill in real values. `.env` is gitignored - DO NOT COMMIT it.

########################################################################
# LOCAL DEVELOPER CAPABILITIES
# Used by agents when selecting work, not by the game or deployment.
########################################################################

# Physical mobile platforms available for hands-on testing:
# none = no mobile devices; ios = iPhone/iPad; android = Android devices;
# all = both ios and android. A comma-separated list is also supported:
# CAN_TEST_MOBILE=ios,android
# Use lowercase names; whitespace and case are ignored. Use none/all alone.
# Missing, empty or invalid values mean none. Emulators do not count.
# Choose only work whose required physical mobile platforms are available.
# Platform access does not certify any particular device/browser matrix.
CAN_TEST_MOBILE=none

########################################################################
# MEDIA GENERATION , SEE `docs/media-gen`
# Used only by hand-run generation scripts before build. Nothing in the
# game, the build or the tests reads these; none is required to develop.
########################################################################

# ElevenLabs sound effects / speech generation
ELEVENLABS_API_KEY=

# MusicAPI.ai - Suno 3rd Party API for music generation
# Model enum on 2026-10-07: sonic-v6, sonic-v6-wild, sonic-v6-mini
GEN_MUSIC_ENDPOINT=https://api.musicapi.ai/api/v1/sonic/create
GET_MUSIC_ENDPOINT=https://api.musicapi.ai/api/v1/sonic/task/
MUSIC_API_KEY=
MUSIC_MODEL_VERSION=sonic-v6
